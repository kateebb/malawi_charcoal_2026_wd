# Make weights
dnnw <- nb2listwdist(dnn, i, type="idw", style="W",
zero.policy=TRUE)
# Moran's I for Residuals
mor3 <- moran.mc(x = i$c1, listw = dnnw,
zero.policy = FALSE, nsim = 5000, adjust.n = T)
mor3
